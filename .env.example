# Copier en `.env` (ignoré par git) et renseigner. Aucune valeur ne doit être versionnée.

# Adresse du compte Atlassian utilisé pour Jira Cloud.
JIRA_EMAIL=
# Jeton d'API Jira en lecture seule, utilisé par l'extraction (AD-5).
JIRA_TOKEN_LECTURE=
# Jeton d'API Jira d'écriture, réservé à l'injecteur (AD-5).
JIRA_TOKEN_INJECTION=
# Jeton personnel Jira Data Center (tests à la demande seulement).
JIRA_DC_PAT=
# Clé de projet Jira propre au worktree (DEMO sur main).
JIRA_PROJET=
# Clé d'API Anthropic (couche LLM, Palier 2).
ANTHROPIC_API_KEY=
# Clé d'API Mistral (fournisseur de second rang).
MISTRAL_API_KEY=
# Clé secrète HMAC de la Pseudonymisation (AD-15).
USINE_CLE_PSEUDO=
# Mode repli : 1 pour lire le Passage enregistré de demo/repli/ (AD-19).
USINE_MODE_REPLI=
